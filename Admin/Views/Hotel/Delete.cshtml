@model Domain.Models.Hotels.Hotel
@{
    Layout = null;
}

<h2>@ViewData["Title"]</h2>

<h4 style="color:red">آیا مطمئن هستین برای حذف هتل ؟</h4>
<br />
<div class="row">
    <div class="form-group  col-md-2">
        <strong>نام:</strong> @Model.Name
    </div>
    <div class="form-group col-md-2">
        <strong>شهر:</strong> @Model.City
    </div>
</div>
<br />
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="form-group col-md-1">
            <button type="submit" class="btn outlined o-danger c-danger">حذف</button>
        </div>
        <div class="form-group col-md-1">
            <a asp-action="Index" class="btn outlined o-glass c-glass">لغو</a>
        </div>
    </div>
</form>