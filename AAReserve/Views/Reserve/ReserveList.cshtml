@{
    ViewData["Title"] = "ReserveList";
}


<div id="DataContainer">
</div>

@section Scripts {
    <script>


        document.addEventListener("DOMContentLoaded", async function () {
            await GetList(1);
            LoadDatePicker()
        });


        async function GetList(page) {
            const fromEl = document.getElementById("fromInput");
            const fromTxt = fromEl == null ? "" : fromEl.value;
            const toEl = document.getElementById("toInput");
            const toTxt = toEl == null ? "" : toEl.value
            var response = await fetch("/Reserve/GetList?page=" + page + "&from=" + fromTxt + "&to=" + toTxt);
            if (response.ok) {
                var res = await response.text();
                var container = document.getElementById("DataContainer");
                container.innerHTML = res;
            }
        }



        async function search() {
            const fromEl = document.getElementById("fromInput");
            const fromTxt = fromEl == null ? "" : fromEl.value;
            const toEl = document.getElementById("toInput");
            const toTxt = toEl == null ? "" : toEl.value
            var response = await fetch("/Reserve/GetList?from=" + fromTxt + " &to=" + toTxt);
            if (response.ok) {
                var res = await response.text();
                var container = document.getElementById("DataContainer");
                container.innerHTML = res;
                LoadDatePicker();
            }
        }

        function LoadDatePicker() {
            $(".example1").pDatepicker({
                initialValue: false,
                format: 'YYYY/MM/DD',
                autoClose: true

            });
        }

    </script>
}

