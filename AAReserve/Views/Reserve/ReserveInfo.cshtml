@using Application.Common.Extenstios
@using Application.Common.Extentions
@using Application.Features.Reservation.Dto

@{
    ViewData["Title"] = "ReserveInfo";
}

@model ReserveInfoDto

<style>
    .container{
    font-size : 20px;
    }
</style>

<div dir="rtl" class="container text-right mt-5">
    <div class="d-flex mb-4 justify-content-between">
        <h2 class="">جزئیات رزرو</h2>
        <button onclick="Cancel(@Model.HotelId , @Model.Id)" class="btn btn-danger px-4"> کنسل </button>
    </div>

    <!-- General Reserve Info -->
    <div class="card">
        <div class="card-header">
            اطلاعات رزرو
        </div>
        <div class="card-body">
            <h1 class="card-title">هتل: @Model.HotelName</h1>
            <div class="row">
                <div class="col-12 col-md-4">
                    <p class="card-text"><strong>تاریخ شروع رزرو:</strong> @Model.FromStr  </p>
                    <p class="card-text"><strong>تاریخ پایان رزرو:</strong> @Model.ToStr  </p>
                </div>
                <div class="col-12 col-md-4">
                    <p class="card-text"><strong>قیمت کل:</strong> @Model.TotalPrice ریال</p>
                    <p class="card-text"><strong>وضعیت:</strong> @Model.Status.GetDescription()</p>
                </div>
                <div class="col-12 col-md-4">
                    <p class="card-text"><strong>تاریخ ایجاد رزرو:</strong> @Model.CreateStr  </p>
                    @if (Model.IsCanceled)
                    {
                        <p class="card-text"><strong>لغو شده:</strong> اره</p>

                    }
                    else
                    {
                        <p class="card-text"><strong>لغو شده:</strong> خیر</p>

                    }
                    <p class="card-text"><strong>مبلغ لغو:</strong> @Model.CancelAmount تومان</p>
                </div>
            </div>



        </div>
    </div>

    <!-- Reserve Details Info -->
    <div class="mt-4">
        <h4>جزئیات اتاق</h4>
        @foreach (var room in Model.Rooms)
        {
            <div class="card p-4 mb-3">
                <div class="card-header bg-light">
                    @room.RoomName
                </div>
                <div class="card-body">
                    <p><strong>شماره اتاق:</strong> @room.RoomId</p>
                    <p><strong>قیمت:</strong> @room.Price ریال</p>
                    <p><strong>قیمت تخت:</strong> @room.BedPrice ریال</p>
                    <p><strong>تعداد تخت اضافی:</strong> @room.NumberOfExtraBed</p>
                </div>

                <h4>میهمان‌ها</h4>
                @foreach (var guest in room.Guests)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <p><strong>نام میهمان:</strong> @guest.FName @guest.LName</p>
                            <p><strong>کد ملی:</strong> @guest.NationalCode</p>
                        </div>
                    </div>
                }



                <h4>جزئیات قیمت روزانه</h4>

                <table dir="rtl" class="table table-striped mt-3 text-right">
                    <thead>
                        <tr>
                            <th scope="col"> </th>
                            <th scope="col">قیمت اتاق</th>
                            <th scope="col">قیمت تخت اضافه</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var daily in room.Dailies)
                        {
                            <tr>
                                <th scope="row">@daily.DateVal.ToPersianDate()</th>
                                <td>@daily.Price.ToString("N0")</td>
                                <td>@daily.BedPrice.ToString("N0")</td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        }




    </div>
</div>



@section Scripts {
    <script>

        async function Cancel(hotelId , id) {

            var response = await fetch("/Cancel/GetPenalty/" + hotelId);
            if (response.ok) {
                var res = await response.text();
                Swal.fire({
                    title: "میخوای رزرو کنسل شه؟",
                    html : res,
                    showDenyButton: true,
                    confirmButtonText: "اره",
                    denyButtonText: `نه`
                }).then((result) => {
                    if (result.isConfirmed) {
                        Confirm(id)
                    }
                });
            }

        }


        async function Confirm(id) {
            const formData = new FormData();
            formData.append("Id", id);
            try {
                const response = await fetch('/Cancel/ConfirmCancel', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                if (response.ok) {

                    UseSwal("success", "عملیات با موفقیت انجام شد");
                    window.location = "/Reserve/ReserveInfo/" + result

                } else {
                    UseSwal("error", result.details);
                }
            } catch (error) {
                console.error('Fetch error:', error);
            }

        }


    </script>
}