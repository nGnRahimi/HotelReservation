@using Application.Common.Extentions
@using Application.Features.Search.Dto

@{
    ViewData["Title"] = "RoomReserve";
}

@model List<SearchRoomDto>

<div class="back_re">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="title">
                    @if (Model.Count > 0)
                    {
                        <h2>@Model[0].HotelName</h2>

                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mt-4">


    <!-- جزئیات خرید -->
    <div class="row" dir="rtl">

        <div class="col-md-8">
            <form id="reserveForm" asp-action="Book" asp-controller="Reserve">

                <div class="card">

                    <input type="hidden" value="@ViewBag.from" name="from" />
                    <input type="hidden" value="@ViewBag.to" name="to" />
                    <input type="hidden" value="@ViewBag.hotelId" name="ToHotelId" />

                    @{
                        int i = 0;
                    }
                    @foreach (var item in Model)
                    {
                        <div>
                            <div>
                                <div style="display: flex;">
                                    <img src="/api/file/GetFile?fileName=@item.Img" alt="#" width="120" />
                                    <div class="mr-3">
                                        <h3 class="text-right"> @item.RoomName </h3>

                                        <div class="number">
                                            <span class="ml-1 text-center">تخت اضافه</span>
                                            <span onclick="RemoveBed(@i, @item.BedPrice)" class="minus btn btn-danger text-center">-</span>
                                            <span id="bedSpan_@i" class="mx-2">0</span>
                                            <input type="hidden" value="0" id="bed_@i" name="rooms[@i].NumberOfExtrabed" />
                                            <input type="hidden" value="@item.RoomId" name="rooms[@i].roomId" />
                                            <span onclick="AddBed(@i , @item.Extra , @item.BedPrice)" class="plus btn btn-danger text-center">+</span>
                                        </div>
                                    </div>

                                </div>
                                <table dir="rtl" class="table table-striped mt-3 text-right">
                                    <thead>
                                        <tr>
                                            <th scope="col"> </th>
                                            <th scope="col">قیمت اتاق</th>
                                            <th scope="col">قیمت تخت اضافه</th>
                                            <th scope="col">ظرفیت</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var daily in item.Details)
                                        {
                                            <tr>
                                                <th scope="row">@daily.DateVal.ToPersianDate()</th>
                                                <td>@daily.Price.ToString("N0")</td>
                                                <td>@daily.BedPrice.ToString("N0")</td>
                                                <td>@daily.Qty</td>
                                            </tr>
                                        }

                                    </tbody>
                                </table>

                            </div>

                            <h5 class="mt-3 text-right">دفترچه مسافران</h5>
                            <div class="mb-3">
                                <label for="name" class="form-label text-right">نام</label>
                                <input type="text" class="form-control" name="rooms[@i].Guests[0].fname" placeholder="نام">
                            </div>
                            <div class="mb-3">
                                <label for="lastname" class="form-label">نام خانوادگی</label>
                                <input type="text" class="form-control" name="rooms[@i].Guests[0].lname" placeholder="نام خانوادگی">
                            </div>
                            <div class="mb-3">
                                <label for="nationalId" class="form-label">کد ملی</label>
                                <input type="text" class="form-control" name="rooms[@i].Guests[0].code" placeholder="کد ملی">
                            </div>
                        </div>

                        i++;
                    }


                </div>
            </form>

        </div>
        <div class="col-md-4" id="stickyDiv">
            <div class="card">
                <h5 class="reservation-summary text-right">جزئیات خرید</h5>
                <p class="text-right">@Model.Count() اتاق x @Model[0].Details.Count() شب</p>
                <div id="totalPrice" class="price">@Model.Sum(a => a.Price).ToString("N0") ریال</div>
                <input type="hidden" value="@Model.Sum(a => a.Price)" id="totalPriceInput" />
                <button onclick="Reserve()" class="btn btn-primary w-100 mt-2">تایید و ادامه</button>
            </div>
        </div>


    </div>

</div>

<style>
    .card {
        margin: 20px;
        padding: 20px;
    }

    .reservation-summary {
        font-size: 18px;
        color: #000;
    }

    .price {
        color: green;
        font-size: 24px;
        font-weight: bold;
    }

    .btn-primary {
        background-color: #007bff;
    }

    .rules {
        margin-top: 20px;
    }

    .counterInput {
        height: 36px;
        width: 50px;
        text-align: center;
        font-size: 26px;
        border: 1px solid #ddd;
        border-radius: 4px;
        display: inline-block;
        vertical-align: middle;
    }


    .sticky {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000; /* Make sure it's on top */
    }
</style>



@section Scripts {
    <script>



        async function Reserve()
        {
            const form = document.getElementById('reserveForm');
            const formData = new FormData(form);

            try {
                const response = await fetch('/Reserve/Book', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                if (response.ok) {

                    UseSwal("success", "عملیات با موفقیت انجام شد");
                    window.location = "/Reserve/ReserveInfo/" + result

                } else {
                    UseSwal("error", result.details);
                }
            } catch (error) {
                console.error('Fetch error:', error);
            }

        }


        function AddBed(i, extra , bedPrice) {
            const span = document.getElementById("bedSpan_" + i);
            const input = document.getElementById("bed_" + i);

            const totalPrice = document.getElementById("totalPrice");
            const totalPriceInput = document.getElementById("totalPriceInput");

            if (input.value < extra) {
                input.value++;
                span.innerHTML = input.value;


                var price = parseInt(totalPriceInput.value) + parseInt(bedPrice);
                totalPriceInput.value = price;
                totalPrice.innerHTML = price.toLocaleString() + "  ریال"


            }


        }



        function RemoveBed(i, bedPrice) {
            const span = document.getElementById("bedSpan_" + i);
            const input = document.getElementById("bed_" + i);

            const totalPrice = document.getElementById("totalPrice");
            const totalPriceInput = document.getElementById("totalPriceInput");

            if (input.value > 0) {
                input.value--;
                span.innerHTML = input.value;

                var price = parseInt(totalPriceInput.value) - parseInt(bedPrice);
                totalPriceInput.value = price;
                totalPrice.innerHTML = price.toLocaleString() + "  ریال"


            }


        }




        window.onscroll = function () { makeSticky() };

        const stickyDiv = document.getElementById("stickyDiv");
        const stickyOffset = stickyDiv.offsetTop;

        function makeSticky() {
            if (window.pageYOffset >= stickyOffset) {
                stickyDiv.classList.add("sticky");
            } else {
                stickyDiv.classList.remove("sticky");
            }
        }


    </script>
}
