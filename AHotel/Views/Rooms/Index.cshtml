@{
	ViewData["Title"] = "Index";
}
<button onclick="Create()" class="btn  f-secondary text-center">ایجاد</button>



<div id="DataContainer">


</div>




@section Scripts{
<script>

    document.addEventListener("DOMContentLoaded", async function () {
        await Load(1);
    });

       

    async function GetList(page){
              const searchEl = document.getElementById("searchInput");
                  const searchTxt = searchEl == null ? "" : searchEl.value
            var response = await fetch("/Rooms/GetList?page=" + page + "&search=" + searchTxt);
            if(response.ok) {
                 var res = await response.text();
                     var container = document.getElementById("DataContainer");
                     container.innerHTML = res;
                      
            }
    }



    async function search()
    {
        const searchTxt = document.getElementById("searchInput").value;
         var response = await fetch("/Rooms/GetList?search=" + searchTxt);
            if(response.ok) {
                 var res = await response.text();
                     var container = document.getElementById("DataContainer");
                     container.innerHTML = res;
                      
            }
    }




	async function Create(){
		$('#MyModal').modal('show');

		var response = await fetch("/Rooms/CreateView");
		if(response.ok) {
             var res = await response.text();
				 $('#MyModalBody').html(res);
		}
	}

	async function SendCreate()
	{
                 const form = document.getElementById('createForm');
                 const formData = new formData(form);
                          await PostForm('/Rooms/CreateRoom' , formData);
                             await GetList(1);
                                  $('#MyModal').modal('hide');
	}



    async function Edit(id , page)
    {
            $('#MyModal').modal('show');

            var response = await fetch("/Rooms/UpdateView/" + id + "?page" + page);
            if(response.ok) {
                 var res = await response.text();
                     $('#MyModalBody').html(res);
            }
        
    }




        async function SendEdit(page)
        {
                         const form = document.getElementById('UpdateForm');
                         const formData = new formData(form);
                         await PostForm('/Rooms/UpdateRoom' , formData);
                         await GetList(page);
                              $('#MyModal').modal('hide');
        }



        function Delete(id , page)
        {
            var func = () => {
                const data = {
                    Id : id,
                };

                  PostJson("Rooms/DeleteRoom" , data , () => GetList(page) );

            }
                DeleteWithSwal(func);
           
        }
         

 </script>
}
