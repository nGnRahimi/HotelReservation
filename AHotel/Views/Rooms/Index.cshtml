@{
	ViewData["Title"] = "Index";
}
<button onclick="Create()" class="btn  f-secondary text-center">ایجاد</button>



<div id="DataContainer">


</div>




@section Scripts{
<script>

    document.addEventListener("DOMContentLoaded", async function () {
        await Load(1);
    });

       

    async function GetList(page){
              const searchEl = document.getElementById("searchInput");
                  const searchTxt = searchEl == null ? "" : searchEl.value
            var response = await fetch("/Rooms/GetList?page=" + page + "&search=" + searchTxt);
            if(response.ok) {
                 var res = await response.text();
                     var container = document.getElementById("DataContainer");
                     container.innerHTML = res;
                      
            }
    }



    async function search()
    {
        const searchTxt = document.getElementById("searchInput").value;
         var response = await fetch("/Rooms/GetList?search=" + searchTxt);
            if(response.ok) {
                 var res = await response.text();
                     var container = document.getElementById("DataContainer");
                     container.innerHTML = res;
                      
            }
    }




	async function Create(){
		$('#MyModal').modal('show');

		var response = await fetch("/Rooms/CreateView");
		if(response.ok) {
             var res = await response.text();
				 $('#MyModalBody').html(res);
		}
	}

	async function SendCreate()
	{
                 const form = document.getElementById('createForm');
                 const formData = new formData(form);

                 try {
                     const response = await fetch('/Rooms/CreateRoom' , {
                         method: 'POST',
                         body: formData
                     });
                    const result = await response.json();

                     if (response.ok){
                       UseSwal("success" ,"عملیات با موفقیت انجام شد");

                            $('#MyModal').modal('hide');
                                 await GetList();
                     }else {
                                UseSwal("error" , result.details);
                  
                     }

                 } catch (error){
                     console.error('Fetch error:', error);
                 }
	}
</script>
}




