@using Application.Common.Extentions
@using Application.Features.RoomCapacities.Dto

@model RoomCapacityDto

<input type="hidden" id="start" value="@ViewBag.start" />

<form id="CalenderForm" method="post">

    <table class="table table-bordered">

        <thead>
            <tr>
                <th scope="col">اتاق ها</th>

                @foreach (var item in Model.Days)
                {
                    <th>
                        <div>
                            <p class="text-center">
                                @item.ToPersianDate()
                            </p>

                            <p class="text-center text-info">
                                @item.ToPersianDayOfWeek()
                            </p>
                        </div>
                    </th>
                }
            </tr>
        </thead>

        <tbody>

            @{
                int i = 0;
            }

            @foreach (var room in Model.Rooms)
            {
                <tr>

                    <th>
                        @room.Name
                    </th>

                    @foreach (var item in Model.Days)
                    {
                        var capacity = room.RoomCapacities
                        .Where(a => a.DateVal.Date == item.Date)
                        .FirstOrDefault();

                        if (capacity != null)
                        {
                            <th>

                                <input type="number"
                                       name="CapacityLists[@i].Qty"
                                       class="form-control"
                                       value="@capacity.Qty" />

                                <input type="hidden"
                                       name="CapacityLists[@i].DateVal"
                                       value="@item" />

                                <input type="hidden"
                                       name="CapacityLists[@i].RoomId"
                                       value="@room.RoomId" />

                            </th>
                        }
                        else
                        {
                            <th>

                                <input type="number"
                                       name="CapacityLists[@i].Qty"
                                       class="form-control" />

                                <input type="hidden"
                                       name="CapacityLists[@i].DateVal"
                                       value="@item" />

                                <input type="hidden"
                                       name="CapacityLists[@i].RoomId"
                                       value="@room.RoomId" />

                            </th>
                        }

                        i++;
                    }

                </tr>
            }

        </tbody>

    </table>

</form>

<button onclick="SendCalender()"
        class="btn f-secondary text-center">
    ذخیره تغییرات
</button>