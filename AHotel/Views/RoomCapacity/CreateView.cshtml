<form id="createForm">

    <div class="row">
        <div class="form-group col-sm-12 col-lg-12">
            <label>اتاق ها</label>

            <select style="width: 100%"
                    name="rooms[]"
                    multiple="multiple"
                    class="form-control js-select"
                    asp-items="@ViewBag.Rooms">
            </select>
        </div>
    </div>

    <div class="row">
        <div class="form-group col-sm-12 col-lg-6">
            <label>از تاریخ</label>
            <input name="from"
                   class="form-control example1">
        </div>

        <div class="form-group col-sm-12 col-lg-6">
            <label>تا تاریخ</label>
            <input name="to"
                   class="form-control example1">
        </div>
    </div>

    <div class="row">
        <div class="form-group col-sm-12 col-lg-6">
            <label>ظرفیت اتاق</label>
            <input name="capacity"
                   type="number"
                   class="form-control"
                   placeholder="2"
                   min="1">
        </div>
    </div>

</form>

<button onclick="SendCreate()"
        class="btn f-secondary text-center">
    ارسال
</button>