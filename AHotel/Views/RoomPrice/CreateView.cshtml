<form id="createForm">

    <div class="row">
        <div class="form-group col-sm-12 col-lg-12">
            <label for="exampleFormControlInput1">اتاق ها</label>
            <select style="width: 100%" name= "rooms[]" multiple="multiple" class="form-control js-select" asp-items="@ViewBag.Rooms"></select>

        </div>

    </div>

    <div class="row">
        <div class="form-group col-sm-12 col-lg-6">
            <label for="exampleFormControlInput1">از تاریخ</label>
            <input name="from" class="form-control example1">
        </div>

        <div class="form-group col-sm-12 col-lg-6">
            <label for="exampleFormControlInput1">تا تاریخ</label>
            <input name="to" class="form-control example1">
        </div>
    </div>

    <div class="row">
        <div class="form-group col-sm-12 col-lg-6">
            <label for="exampleFormControlInput1">قیمت اتاق</label>

            <input name="price"
                   type="text"
                   class="form-control"
                   placeholder="20000">
        </div>

        <div class="form-group col-sm-12 col-lg-6">
            <label for="exampleFormControlInput1">قیمت تخت اضافه</label>
            <input name="bedPrice" type="text" class="form-control"
            placeholder="10000" />

        </div>


        </form>
        <button onclick="SendCreate()" class="btn  f-secondary text-center">ارسال</button>