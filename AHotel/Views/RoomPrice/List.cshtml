@using Application.Common.Extentions
@using Application.Features.RoomPrices.Dto

@model RoomPriceDto

<input type="hidden" id="start" value="@ViewBag.start" />
<form id="CalenderForm" method="post">
	<table class="table table-bordered">
		<thead>
			<tr>
				<th scope="col">اتاق ها</th>
				@foreach (var item in Model.Days)
				{
					<th>
						<div>
							<p class="text-center">
								@item.ToPersianDate()
							</p>

							<p class="text-center text-info">
								@item.ToPersianDayOfWeek()
							</p>
						</div>

					</th>

				}
			</tr>
		</thead>
		<tbody>

			@{
				int i = 0;
			}
			@foreach (var room in Model.Rooms)
			{
				<tr>
						<th>@room.Name</th>
					@foreach (var item in Model.Days)
					{
						var price = room.RoomPrices.Where(a => a.DateVal.Date == item.Date).FirstOrDefault();
						if (price != null)
						{
							<th>
								<input type="number" name="PriceLists[@i].Price" class="form-control" value="@price.Price" />
								<input type="number" name="PriceLists[@i].BedPrice" class="form-control" value="@price.BedPrice" />
								<input type="hidden" name="PriceLists[@i].DateVal" class="form-control" value="@item" />
								<input type="hidden" name="PriceLists[@i].RoomId" class="form-control" value="@room.RoomId" />
							</th>

						}

						else
						{
							<th>
								<input type="number" name="PriceLists[@i].Price" class="form-control" />
								<input type="number" name="PriceLists[@i].BedPrice" class="form-control" />
								<input type="hidden" name="PriceLists[@i].DateVal" class="form-control" value="@item" />
								<input type="hidden" name="PriceLists[@i].RoomId" class="form-control" value="@room.RoomId" />
							</th>
						}

						i++;

					}

				</tr>
			}



		</tbody>
	</table>
</form>
<button onclick="SendCalender()" class="btn  f-secondary text-center">ذخیره تغییرات</button>

