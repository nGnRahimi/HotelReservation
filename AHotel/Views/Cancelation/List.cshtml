@using Application.Features.Cancelation.Dto
@model List<PolicyDto>

@{
    int i = 0;
}
@foreach(var item in Model)
{
    <div id="accordion_@i " class="accordion card mt-2 shade ">
        <div class="">
            <div class="card-header mr-3 ml-3 pr-0 pl-0" id="headingOne_@i">
                <h5 class="mb-0">
                    <button class="btn btn-link c-grey w-100 m-0 text-right"
                            data-toggle="collapse" data-target="#collapseOne_@i" aria-expanded="true"
                            aria-controls="collapseOne_@i">
                        <p class="mr-3">@item.Title</p>
                        <p class="mr-3">از تاریخ @item.FromPersian</p>
                        <p class="mr-3">تا تاریخ @item.ToPersian</p>
                        <i class="fas fa-chevron-left"></i>
                    </button>
                </h5>
            </div>

            <div id="collapseOne_@i" class="collapse " aria-labelledby="headingOne"
                 data-parent="#accordion_@i">
                <div class="card-body">

                    <button onclick="Remove(@item.Id)" class="btn  btn-danger text-center">آرشیو</button>


                    <table class="table table-striped">
                      
                        <tbody>
                            @foreach (var rule in item.Rules)
                            {
                                <tr>
                                    <th>تا @rule.Hours ساعت قبل از ورود مهمان</th>
                                    <td>@rule.RefundPercent درصد مبلغ رزرو بازپرداخت میشود</td>
                                   
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
    i++;
}
